<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>hours</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@hours@</string>
        <key>hours</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>час</string>
            <key>few</key>
            <string>часа</string>
            <key>other</key>
            <string>часов</string>
        </dict>
    </dict>
    <key>days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@number@</string>
        <key>number</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d дней</string>
            <key>one</key>
            <string>%d день</string>
            <key>two</key>
            <string>%d дня</string>
            <key>few</key>
            <string>%d дня</string>
            <key>many</key>
            <string>%d дней</string>
            <key>other</key>
            <string>%d дней</string>
        </dict>
    </dict>
    <key>weeks</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@number@</string>
        <key>number</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d недель</string>
            <key>one</key>
            <string>%d неделя</string>
            <key>two</key>
            <string>%d недели</string>
            <key>few</key>
            <string>%d недели</string>
            <key>many</key>
            <string>%d недель</string>
            <key>other</key>
            <string>%d недель</string>
        </dict>
    </dict>
    <key>months</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@number@</string>
        <key>number</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d месяцев</string>
            <key>one</key>
            <string>%d месяц</string>
            <key>two</key>
            <string>%d месяца</string>
            <key>few</key>
            <string>%d месяца</string>
            <key>many</key>
            <string>%d месяцев</string>
            <key>other</key>
            <string>%d месяцев</string>
        </dict>
    </dict>
    <key>years</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@number@</string>
        <key>number</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d лет</string>
            <key>one</key>
            <string>%d год</string>
            <key>two</key>
            <string>%d года</string>
            <key>few</key>
            <string>%d года</string>
            <key>many</key>
            <string>%d лет</string>
            <key>other</key>
            <string>%d лет</string>
        </dict>
    </dict>
</dict>
</plist>
